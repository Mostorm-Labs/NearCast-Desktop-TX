{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NearHub Cast",
  "version": "0.1.0",
  "identifier": "com.mostorm.nearhub.cast",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NearHub Cast",
        "width": 960,
        "height": 640
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        {
          "identifier": "main-events",
          "description": "Receive native LAN discovery snapshots in the sender window",
          "windows": [
            "main"
          ],
          "permissions": [
            "core:event:allow-listen",
            "core:event:allow-unlisten"
          ]
        }
      ]
    },
    "withGlobalTauri": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU2MUZDNjRERDgwRTFEOEYKUldTUEhRN1lUY1lmNXJFNTVxUHErWFBtUlBMUDUrZU9ZcnV0ZGJRMW1ET1F5VGYwWndLN1lZcUoK",
      "requireSignedVersion": true
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "targets": [
      "nsis",
      "msi",
      "app",
      "dmg"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "wix": {
        "template": "installer/main.wxs"
      },
      "nsis": {
        "template": "installer/installer.nsi"
      }
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-",
      "infoPlist": "Info.plist"
    }
  }
}
