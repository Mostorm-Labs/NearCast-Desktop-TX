<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>NSLocalNetworkUsageDescription</key>
  <string>NearCast Desktop TX 需要访问局域网，以发现 NearCast 和 AirPlay 接收设备。</string>
  <key>NSBonjourServices</key>
  <array>
    <string>_nearcast._tcp</string>
    <string>_airplay._tcp</string>
    <string>_raop._tcp</string>
  </array>
  <key>NSScreenCaptureUsageDescription</key>
  <string>NearCast Desktop TX 需要屏幕录制权限，才能把你选择的屏幕发送到接收端。</string>
  <key>NSAccessibilityUsageDescription</key>
  <string>NearCast Desktop TX 需要辅助功能权限，才能在 WebCast 反向控制中注入鼠标事件。</string>
</dict>
</plist>
